# Server Configuration
PORT=3000

# GitHub Configuration
# Generate a Personal Access Token (classic with 'repo' scope OR Fine-grained with Contents Read & Write)
# https://github.com/settings/tokens
GITHUB_TOKEN=your_personal_access_token_here

# Target repository details (e.g., https://github.com/RIKKY-J/LeetPush or your dedicated solutions repo)
GITHUB_OWNER=RIKKY-J
GITHUB_REPO=LeetPush
GITHUB_BRANCH=main

# Default root folder in the repository where solutions are placed
GITHUB_BASE_DIR=leetcode

# Commit message prefix/format (optional)
COMMIT_MESSAGE_PREFIX=leetcode
